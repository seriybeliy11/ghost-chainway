generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TelegramUser {
  id            Int      @id
  firstName     String
  lastName      String?
  username      String?
  photoUrl      String?
  languageCode  String?
  isBot         Boolean  @default(false)
  authDate      DateTime @default(now())
  referrerCode  String?  @unique
  referredById  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  referrals     TelegramUser[]  @relation("Referrals")
  parent        TelegramUser?   @relation("Referrals", fields: [referredById], references: [id])
  subscriptions Subscription[]

  @@unique([id])
  @@index([referrerCode])
  @@index([referredById])
}

model Subscription {
  id              String       @id @default(cuid())
  telegramUserId  Int
  planType        String       @default("free")
  generationsLeft Int          @default(5)
  totalPurchased  Int          @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  telegramUser    TelegramUser @relation(fields: [telegramUserId], references: [id])

  @@index([telegramUserId])
}